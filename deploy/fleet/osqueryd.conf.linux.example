{
  "options": {
    "schedule_splay_percent": "10",
    "worker_threads": "2",
    "host_identifier": "hostname",
    "disable_events": "false",
    "verbose": "false",
    "enable_file_events": "true"
  },
  "schedule": {
    "processes": {
      "query": "SELECT pid, name, path, cmdline, uid, gid, parent, start_time, resident_size FROM processes;",
      "interval": 60,
      "description": "All running processes - differential mode detects new process launches (cross-platform)"
    },
    "listening_ports": {
      "query": "SELECT lp.pid, lp.port, lp.protocol, lp.address, p.name, p.path FROM listening_ports lp JOIN processes p ON lp.pid = p.pid WHERE lp.address != '127.0.0.1';",
      "interval": 120,
      "description": "Network listeners excluding localhost - detects backdoors and C2 beacons"
    },
    "logged_in_users": {
      "query": "SELECT type, user, host, time, pid FROM logged_in_users;",
      "interval": 60,
      "description": "Active sessions - session-state only; auth FAILURES come from the Linux auth shipper (journalctl/auth.log), per the auth-source contract"
    },
    "open_sockets": {
      "query": "SELECT pid, remote_address, remote_port, local_address, local_port, protocol FROM process_open_sockets WHERE remote_address != '' AND remote_address != '::' AND remote_address != '0.0.0.0';",
      "interval": 60,
      "description": "Active network connections - critical for C2 and exfil detection"
    },
    "shell_history": {
      "query": "SELECT uid, time, command, history_file FROM shell_history WHERE command != '';",
      "interval": 600,
      "description": "Command history - post-exploitation detection"
    },
    "crontab": {
      "query": "SELECT event, minute, hour, day_of_month, month, day_of_week, command, path FROM crontab;",
      "interval": 300,
      "description": "Scheduled tasks - persistence mechanism detection (Linux cron)"
    },
    "startup_items": {
      "query": "SELECT name, path, source, status, username FROM startup_items;",
      "interval": 300,
      "description": "Autostart entries (XDG autostart on Linux) - persistence detection"
    },
    "disk_encryption": {
      "query": "SELECT name, encrypted, type, uid, encrypted FROM disk_encryption WHERE encrypted = 1;",
      "interval": 3600,
      "description": "LUKS status - compliance check. Intentionally NOT in the ECS map (compliance table, dropped by parser as unmapped - P2-37)"
    },
    "user_ssh_keys": {
      "query": "SELECT uid, path, encrypted FROM user_ssh_keys;",
      "interval": 3600,
      "description": "SSH keys - monitors for unauthorized key creation"
    },
    "file_events": {
      "query": "SELECT target_path, action, transaction_id, inode, uid, gid, mode, size, atime, mtime, ctime, md5, sha1, sha256, time FROM file_events;",
      "interval": 60,
      "description": "FIM events for watched path sets (inotify-backed on Linux; see file_paths below)"
    }
  },
  "file_paths": {
    "ssh_credentials": [
      "/home/%/.ssh/%%",
      "/root/.ssh/%%"
    ],
    "tmp_staging": [
      "/tmp/%%",
      "/var/tmp/%%",
      "/dev/shm/%%"
    ],
    "cron_persistence": [
      "/etc/cron.d/%%",
      "/etc/cron.daily/%%",
      "/etc/cron.hourly/%%",
      "/var/spool/cron/%%"
    ],
    "systemd_persistence": [
      "/etc/systemd/system/%%"
    ],
    "system_log_paths": [
      "/var/log/%%"
    ]
  },
  "exclude_paths": {
    "tmp_staging": [
      "/tmp/osquery%",
      "/var/tmp/osquery%"
    ]
  }
}