# === Database ===
DB_HOST=localhost
DB_PORT=5433
DB_NAME=scarletai
DB_USER=scarletai
# Generate with: openssl rand -base64 32
# Then run in psql: ALTER USER scarletai WITH PASSWORD '<value>';
DB_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32
DB_POOL_MIN=2
DB_POOL_MAX=10
# NOTE: do NOT set DATABASE_URL — the DSN is DERIVED in src/config/settings.py
# from DB_HOST/DB_PORT/DB_NAME/DB_USER/DB_PASSWORD (URL-encoded so a rotated
# password with special chars can't break the DSN). Setting DATABASE_URL by
# hand is a stale-DSN footgun: rotate DB_PASSWORD but forget to update
# DATABASE_URL and you debug a stale connection string.

# === Redis ===
REDIS_URL=redis://localhost:6379/0

# === API ===
API_HOST=127.0.0.1
API_PORT=8000
API_SECRET_KEY=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_64
API_BEARER_TOKEN=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_HEX_32
API_CORS_ORIGINS=http://localhost:8501

# === Scoped ingest token (optional, P2.6) ===
# A SECOND bearer token, viewer-class and valid ONLY on the ingest router.
# Give it to agents/pipelines that only need to ship events: if it leaks,
# it cannot browse alerts/cases/query (every non-ingest endpoint rejects it).
# Leave unset to disable (behavior identical to pre-P2.6).
# Generate with: openssl rand -hex 32
# INGEST_BEARER_TOKEN=

# === Password pepper (optional, P2-9) ===
# A server-side secret mixed into password hashing (HMAC-SHA256) BEFORE the
# SHA-256 pre-hash + bcrypt. Protects against DB-only leaks: an attacker with
# the siem_users table but NOT this secret cannot offline-crack the hashes.
# Backward compat: leave unset to keep existing hashes validating (no pepper).
# Rotating the pepper requires rehashing all passwords (password reset flow).
# Generate with: openssl rand -hex 32
# PASSWORD_PEPPER=

# === Dashboard (Epic 10) ===
# Optional: static bearer token for headless / docker dashboard. When set,
# the dashboard can call the API without a user login (service-to-service).
# Leave blank to require manual JWT login. Should match one of the tokens
# the API accepts (typically the same value as API_BEARER_TOKEN, but kept
# separate so the dashboard container can be configured independently).
DASHBOARD_API_TOKEN=

# Show the "Initial setup (operators)" expander on the dashboard login
# screen (docker-logs password retrieval + seed-admin bootstrap). Off by
# default — login is the front door; flip to 1 only while bootstrapping.
DASHBOARD_SHOW_SETUP_HELP=

# === Bootstrap ===
# POST /auth/seed-admin is a localhost-only dev bootstrap that creates an
# admin with the known weak password "admin" (must_change_password=true).
# Default false: the endpoint returns 404 so it is NOT a second
# weak-password bootstrap path in prod. Production bootstrap is the Docker
# entrypoint (random password written to data/admin_initial_password, chmod 600).
# Enable only for local dev: SEED_ADMIN_ENABLED=true
SEED_ADMIN_ENABLED=false

# === Ollama ===
OLLAMA_BASE_URL=http://localhost:11434
# Default is the model installed in the reference deploy (verified
# 2026-08-26). Pull it with: ollama pull mistral:7b
OLLAMA_MODEL=mistral:7b
OLLAMA_TIMEOUT=30

# === API docs exposure ===
# When false, the Swagger UI (/api/docs), ReDoc (/api/redoc) and
# /openapi.json are not served. Default true (dev/CI). The prod overlay
# (docker-compose.prod.yml) sets DOCS_ENABLED=false.
DOCS_ENABLED=true

# === osquery ===
OSQUERY_LOG_PATH=/var/log/osquery/osqueryd.results.log
OSQUERY_CONFIG_PATH=/var/osquery/osquery.conf

# === Threat Intel (free tier API keys) ===
# Air-gapped / no-egress mode: set THREAT_INTEL_ENABLED=false to disable the
# periodic refresh scheduler and the on-boot refresh entirely (no calls to
# URLhaus/AbuseIPDB/OTX). IOC enrichment then matches only the local
# threat_intel cache (pre-load IOCs offline first). See docs/AIR-GAPPED.md.
THREAT_INTEL_ENABLED=true
ABUSEIPDB_API_KEY=
OTX_API_KEY=

# === Notifications (optional) ===
SLACK_WEBHOOK_URL=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
ALERT_EMAIL_TO=

# === Logging ===
LOG_LEVEL=INFO
LOG_FORMAT=console

# Rate limits (slowapi limit strings). Defaults are aggressive for production
# (5 logins/min/IP deters brute force). Raise LOGIN_RATE_LIMIT for interactive
# / demo use, e.g. LOGIN_RATE_LIMIT=60/minute. Requires an API restart to apply.
# LOGIN_RATE_LIMIT=5/minute
# INGEST_RATE_LIMIT=100/minute

# Retention (P1-D) — bounded storage. 0 = keep forever. The retention
# job runs hourly and deletes rows older than the window in batched
# parameterized DELETEs (no table-wide lock). Tune per deployment.
# LOGS_RETENTION_DAYS=30
# ALERTS_RETENTION_DAYS=180
# AUDIT_RETENTION_DAYS=365
# CORRELATION_RETENTION_DAYS=90
# AI_USAGE_RETENTION_DAYS=90
# RETENTION_INTERVAL_HOURS=1
# RETENTION_BATCH_SIZE=5000

# ── Redis (PRODUCTION REQUIRED) ───────────────────────────────
# Redis auth for the production overlay (docker-compose.prod.yml enforces
# --requirepass and rewrites REDIS_URL to include it). The DEV compose runs
# redis without a password (localhost-only, port published for host mode).
# Generate: openssl rand -base64 32
#REDIS_PASSWORD=CHANGE_ME_GENERATE_WITH_OPENSSL_RAND_BASE64_32

# ── Demo seed (OPT-IN — demo hosts only) ─────────────────────
# Demo seeding (synthetic alerts + the documented demo credential) is opt-in
# as of 2026-09-01: the Docker entrypoint only seeds demo data when this is
# "true". Default false — production boots stay empty. Set in .env BEFORE the
# first `make up` on a demo host. See docs/DEMO.md.
#DEMO_SEED_ENABLED=false
